{
  "name": "karla",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "refresh:stops": "node --experimental-strip-types --import ./tests/register-resolver.js scripts/refresh-stop-catalog.ts",
    "refresh:stop-places": "node --experimental-strip-types --import ./tests/register-resolver.js scripts/write-stop-places.ts",
    "refresh:line-colors": "node --experimental-strip-types --import ./tests/register-resolver.js scripts/refresh-line-colors.ts",
    "probe:turnarounds": "node --experimental-strip-types --import ./tests/register-resolver.js scripts/probe-turnarounds.ts",
    "test": "node --experimental-strip-types --import ./tests/register-resolver.js --test tests/*.test.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "solve:region": "node --experimental-strip-types --import ./tests/register-resolver.js scripts/solve-region-plan.ts",
    "solve:zentrum": "node --experimental-strip-types --import ./tests/register-resolver.js scripts/solve-zentrum-layout.ts",
    "probe:trias": "node --experimental-strip-types --import ./tests/register-resolver.js scripts/probe-trias.ts",
    "proxy": "set -a && { [ -f .env.local ] && . ./.env.local; true; } && php -S localhost:8080 -t proxy/public"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "rolldown": "1.2.14",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
