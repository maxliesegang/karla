{
  "name": "karla",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "refresh:stops": "node --experimental-strip-types scripts/refresh-stop-catalog.ts",
    "probe:cadence": "node --experimental-strip-types --import ./tests/register-resolver.js scripts/probe-feed-cadence.ts",
    "test": "node --experimental-strip-types --import ./tests/register-resolver.js --test tests/*.test.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@eslint/js": "9.39.5",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  }
}
